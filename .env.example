# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). A chave "anon"/"publishable" é pública por natureza:
# a segurança vem das regras RLS do banco. NUNCA coloque aqui a chave "service_role"/"secret".
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Opcional: CAPTCHA do Cloudflare Turnstile no cadastro/login (chave do SITE, pública).
# Deixe vazio para desligar. Também ligue o CAPTCHA no Supabase com a chave SECRETA.
VITE_TURNSTILE_SITE_KEY=

# Anúncios para quem não é Pro: proprios (padrão, seguro) | adsense | off
VITE_ADS=proprios
# Só com VITE_ADS=adsense (exige domínio próprio e aprovação do Google)
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
